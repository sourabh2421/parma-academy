rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Replace ADMIN_EMAIL_HERE with your real admin address (must match Firebase Auth user).

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'parma.academy.2004@gmail.com';
    }

    match /students/{studentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /fees/{feeId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /studentFeeRecords/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
